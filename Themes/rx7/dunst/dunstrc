# ─── RX7 Theme · Dunst ───────────────────────────────────────────────────────
[global]
    monitor              = 0
    follow               = mouse
    width                = 320
    height               = 100
    origin               = top-right
    offset               = 10x40
    transparency         = 10
    separator_height     = 2
    padding              = 10
    horizontal_padding   = 12
    frame_width          = 2
    frame_color          = "#63CC00"
    font                 = JetBrainsMono Nerd Font 10
    markup               = full
    format               = "<b>%s</b>\n%b"
    alignment            = left
    corner_radius        = 6
    icon_position        = left
    max_icon_size        = 32
    icon_theme           = Papirus-Dark
    mouse_left_click     = close_current
    mouse_right_click    = close_all

[urgency_low]
    background  = "#0D0D0D"
    foreground  = "#c0caf5"
    frame_color = "#1a1a2e"
    timeout     = 4

[urgency_normal]
    background  = "#0D0D0D"
    foreground  = "#c0caf5"
    frame_color = "#63CC00"
    timeout     = 6

[urgency_critical]
    background  = "#0D0D0D"
    foreground  = "#CC0063"
    frame_color = "#CC0063"
    timeout     = 0
