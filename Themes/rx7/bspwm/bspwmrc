#!/bin/sh
# ─── RX7 Theme · BSPWM ───────────────────────────────────────────────────────

bspc monitor -d I II III IV V VI VII VIII IX X

# Layout
bspc config border_width          2
bspc config window_gap            8
bspc config split_ratio           0.52
bspc config borderless_monocle    true
bspc config gapless_monocle       false
bspc config focus_follows_pointer true

# Colores HTB / RX7
bspc config normal_border_color   "#1a1a2e"
bspc config active_border_color   "#63CC00"
bspc config focused_border_color  "#00CC69"
bspc config presel_feedback_color "#6900CC"

# Reglas de ventanas
bspc rule -a "Burp Suite"  state=tiled desktop='^3'
bspc rule -a burpsuite     state=tiled desktop='^3'
bspc rule -a firefox       state=tiled desktop='^2'
bspc rule -a Thunar        state=floating rectangle=900x600+0+0 center=true
bspc rule -a Gimp          state=floating follow=on
bspc rule -a Screenkey     manage=off

# Wallpaper
WALLPAPER="$HOME/.config/Wallpaper/rx7.jpg"
[ -f "$WALLPAPER" ] && feh --bg-scale "$WALLPAPER" || xsetroot -solid "#0D0D0D"

# Cursor
xsetroot -cursor_name left_ptr

# Autostart
pkill -x sxhkd 2>/dev/null; sleep 0.1
sxhkd &
pkill -x picom 2>/dev/null; sleep 0.1
picom --config ~/.config/picom/picom.conf -b &
dunst &
~/.config/polybar/launch.sh &
pgrep -f vmware-user > /dev/null 2>&1 || { vmware-user-suid-wrapper > /tmp/vmware.log 2>&1 & disown; }
